    {
      "kind": "javascript-module",
      "path": "src/components/orc-segmented.ts",
      "declarations": [
        {
          "kind": "class",
          "description": "`<orc-segmented>` is a single-select segmented control (WAI-ARIA radiogroup\npattern). Unlike `<orc-tabs>` it owns no panels — it just picks one value.\n\nContent API: provide direct child elements carrying a `value` attribute; each\nchild's text becomes the segment label. Children are read from light DOM as\ndata and re-rendered as accessible radios in the shadow root.\n\n```html\n<orc-segmented value=\"orc\" label=\"Orc mode\">\n  <button value=\"orc\">/orc</button>\n  <button value=\"orc-quick\">/orc-quick</button>\n</orc-segmented>\n```\n\n`value` selects the active segment and stays in sync with the selection. A\n`change` CustomEvent (composed, bubbles) fires on selection with\n`detail: { value, label }`. `label` sets the group's accessible name.",
          "name": "OrcSegmented",
          "slots": [
            {
              "description": "Elements carrying a `value` attribute, read as segment data.",
              "name": ""
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "value",
              "type": {
                "text": "string"
              },
              "description": "The value of the currently selected segment, or \"\" when empty."
            }
          ],
          "events": [
            {
              "name": "change",
              "type": {
                "text": "CustomEvent"
              },
              "description": "`CustomEvent<{ value: string; label: string }>` on selection."
            }
          ],
          "attributes": [
            {
              "name": "value",
              "type": {
                "text": "string"
              },
              "description": "Selected segment value; stays in sync with selection."
            },
            {
              "name": "label",
              "type": {
                "text": "string"
              },
              "description": "Accessible name for the radiogroup."
            }
          ],
          "superclass": {
            "name": "HTMLElementBase",
            "module": "src/components/orc-segmented.ts"
          },
          "tagName": "orc-segmented",
          "customElement": true
        }
      ],
      "exports": [
        {
          "kind": "js",
          "name": "OrcSegmented",
          "declaration": {
            "name": "OrcSegmented",
            "module": "src/components/orc-segmented.ts"
          }
        }
      ]
    },
